# Porta do servidor
PORT=3000

# Senha inicial do organizador (mínimo 6 caracteres).
# Se vazio, uma senha aleatória é gerada e exibida no console no primeiro início.
ORGANIZER_PASSWORD=

# Defina como 1 se o app estiver atrás de proxy/túnel (Cloudflare, ngrok, etc.)
TRUST_PROXY=0

# --- E-mail (opcional) ---
# Sem SMTP configurado, os participantes consultam o resultado no site com a senha de 4 dígitos.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Amigo Secreto
